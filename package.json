{
  "name": "fullstack-messaging-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run build:shared && pnpm run --parallel dev",
    "dev:shared": "pnpm --filter @mail-system/shared dev",
    "dev:backend": "pnpm --filter mail-system-backend dev",
    "dev:frontend": "pnpm --filter mail-system-frontend dev",
    "build:shared": "pnpm --filter @mail-system/shared build",
    "build": "pnpm run build:shared && pnpm -r --filter !@mail-system/shared build",
    "build:backend": "pnpm --filter mail-system-backend build",
    "build:frontend": "pnpm --filter mail-system-frontend build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter mail-system-backend test"
  }
}
