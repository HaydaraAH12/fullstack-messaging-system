# Server
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nameofdatabase?schema=public"

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# ---------------------------------------------------------------------------
# Gmail SMTP (Nodemailer) — required to send notification emails on new message
# ---------------------------------------------------------------------------
# 1. Google Account → Security → 2-Step Verification (must be ON)
# 2. App passwords → create one for "Mail" / "Other"
# 3. Use that 16-character password as SMTP_PASS (not your normal Gmail password)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Mail System" <your.address@gmail.com>
